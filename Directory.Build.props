<Project>
  <PropertyGroup>
    <!-- Frameworks every packable library and test project targets. Edit this list to add or drop a framework. -->
    <FirebendTargetFrameworks>net9.0;net10.0</FirebendTargetFrameworks>
    <!-- Single framework for samples, benchmarks, and other runnable apps. -->
    <FirebendAppTargetFramework>net10.0</FirebendAppTargetFramework>
  </PropertyGroup>
</Project>
