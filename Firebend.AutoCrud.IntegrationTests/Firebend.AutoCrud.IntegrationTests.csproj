<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- References the runnable Web.Sample app, so it follows the app framework. -->
        <TargetFramework>$(FirebendAppTargetFramework)</TargetFramework>

        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Bogus" />
        <PackageReference Include="CsvHelper" />
        <PackageReference Include="FluentAssertions" />
        <PackageReference Include="Flurl.Http" />
        <PackageReference Include="Flurl.Http.Newtonsoft" />
        <PackageReference Include="GitHubActionsTestLogger">
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
          <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.AspNetCore.JsonPatch" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="MSTest.TestAdapter" />
        <PackageReference Include="MSTest.TestFramework" />
        <PackageReference Include="coverlet.collector">
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
          <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Firebend.AutoCrud.Core\Firebend.AutoCrud.Core.csproj" />
      <ProjectReference Include="..\Firebend.AutoCrud.Web.Sample\Firebend.AutoCrud.Web.Sample.csproj" />
    </ItemGroup>

</Project>
